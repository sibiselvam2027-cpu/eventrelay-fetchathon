# Keep .env private. Never paste credentials into chat or commit them to Git.
ASI1_API_KEY=
ASI1_MODEL=asi1
EVENTRELAY_AGENT_SEED=
EVENTRELAY_DB=data/eventrelay.db
EVENTRELAY_STATE_DB=data/conversations.db
# This release starts with synthetic people and simulated vendor responses.
EVENTRELAY_DEMO_MODE=1
EVENTRELAY_DEMO_DECISIONS={"staff_arun":"decline","staff_neha":"accept","staff_ravi":"accept","staff_sara":"accept","staff_meena":"accept","staff_kiran":"accept","staff_vikram":"accept","staff_pooja":"accept"}
# Live mode: comma-separated authenticated agent sender addresses.
EVENTRELAY_ORGANIZER_SENDERS=
EVENTRELAY_HOSPITALITY_SENDERS=
EVENTRELAY_TECHNICAL_SENDERS=
